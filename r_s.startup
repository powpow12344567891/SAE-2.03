#!/bin/bash
ip addr add 172.16.210.2/30 dev eth0
ip link set eth0 up

ip addr add 172.16.192.3/23 dev eth1 
ip link set eth1 up

echo 1 > /proc/sys/net/ipv4/ip_forward

# Routes statiques
ip route add default via 172.16.210.1
ip route add 172.16.195.0/23 via 172.16.192.5
ip route add 172.16.196.0/24 via 172.16.210.1
ip route add 172.16.193.0/24 via 172.16.210.1