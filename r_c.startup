#!/bin/bash
ip a add 172.16.210.10/30 dev eth0   # net2 vers r (même masque que r)
ip a add 172.16.193.254/24 dev eth1  # vers net6
ip link set eth0 up
ip link set eth1 up
ip route add 172.16.192.0/22 via 172.16.210.9    # via r
ip route add 172.16.196.0/24 via 172.16.210.9    # via r
sysctl -w net.ipv4.ip_forward=1
