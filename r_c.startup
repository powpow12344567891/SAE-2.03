
ip a add 172.16.210.10/30 dev eth0   
ip a add 172.16.193.254/24 dev eth1  
ip link set eth0 up
ip link set eth1 up
echo "nameserver 8.8.8.8" > /etc/resolv.conf


ip route add default via 172.16.210.9 

sysctl -w net.ipv4.ip_forward=1
echo "nameserver 8.8.8.8" > /etc/resolv.conf 

apt update && apt install -y isc-dhcp-server
echo 'INTERFACESv4="eth1"' > /etc/default/isc-dhcp-server
cat > /etc/dhcp/dhcpd.conf <<EOF
default-lease-time 600;
max-lease-time 7200;
authoritative;

subnet 172.16.193.0 netmask 255.255.255.0 {
  range 172.16.193.001 172.16.193.200;
  option routers 172.16.193.254;
  option domain-name-servers 8.8.8.8;
}
EOF
systemctl restart isc-dhcp-server