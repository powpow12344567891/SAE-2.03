#!/bin/bash
ip a add 172.16.210.6/30 dev eth0   # net3 vers r
ip a add 172.16.196.254/24 dev eth1  # vers net7
ip link set eth0 up
ip link set eth1 up
ip route add default via 172.16.210.5  
ip route add 172.16.192.0/23 via 172.16.210.5    # vers net4/net5 via r
ip route add 172.16.195.0/23 via 172.16.210.5    # vers net4/net5 via r

ip route add 172.16.193.0/24 via 172.16.210.5    # vers net6 via r
echo 1 > /proc/sys/net/ipv4/ip_forward
echo "nameserver 8.8.8.8" > /etc/resolv.conf
